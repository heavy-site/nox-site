# nøx — venue site (cPanel/LiteSpeed)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The certificate is in place, but nothing sent visitors to it: whoever typed
  # noxpl4ce.com was served over plain HTTP and saw "Not secure". First rule in
  # the file, so a plain-HTTP request never reaches the ones below.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Extensionless API routes → PHP files
  RewriteRule ^api/site/?$   /api/site.php   [L,QSA]
  RewriteRule ^api/rent/?$   /api/rent.php   [L,QSA]

  # Pages without .html
  RewriteRule ^events/?$     /events.html    [L,QSA]
  RewriteRule ^booking/?$    /booking.html   [L,QSA]

  # A visitor who types the .html form lands on the clean URL
  RewriteCond %{THE_REQUEST} \s/+(events|booking)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ── Cache policy ────────────────────────────────────────────────────────────
# LiteSpeed sends no Cache-Control for HTML, so browsers fall back to heuristic
# caching and never revalidate — a deploy then shows up in one browser and not
# another. Always revalidate the HTML; a 304 costs nothing. Posters are replaced
# in place under the same filename, so they revalidate too.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "-poster\.(png|jpe?g|webp)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(ttf|woff2?|svg|jpe?g|png|webp|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Config files must never be served, wherever they land.
<FilesMatch "^(nox_config|config\.sample).*\.php$">
  Require all denied
</FilesMatch>

# Internal helpers are includes, not endpoints.
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

Options -Indexes
